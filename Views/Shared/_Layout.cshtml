<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Laboratorios CampusTech</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            background-color: #f3f4f6;
            font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        .navbar-modern {
            background: linear-gradient(90deg, #0d1b2a, #1b263b);
            box-shadow: 0 3px 10px rgba(0,0,0,0.25);
        }

        .navbar-brand {
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .container-modern {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.10);
        }

        footer {
            margin-top: 50px;
            padding: 20px 0;
            background: #1b263b;
            color: white;
            text-align: center;
            font-size: 0.9rem;
        }

        .nav-link {
            font-size: 1rem !important;
        }

        .nav-link:hover {
            opacity: 0.8;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-modern mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fs-4" asp-controller="Reservas" asp-action="Index">
                🧪 CampusTech
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Reservas" asp-action="Index">
                            📋 Listado de reservas
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Reservas" asp-action="Create">
                            ➕ Nueva reserva
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <div class="container container-modern">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        © @DateTime.Now.Year CampusTech · Sistema de Reservas
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
